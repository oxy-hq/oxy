# Reference GitHub Actions workflow for a customer-app bundle.
#
# Copy this into the customer-apps repo as `.github/workflows/deploy.yml`
# (drop the `.example` suffix).
#
# One-way deploy: build, then `oxy publish` uploads the bundle to oxy,
# which stores it in S3 as a versioned build and points the channel at
# it. No `aws s3 sync`, no DB `ensure`, no `/sync` callback — the publish
# endpoint does all of that server-side. CI talks only to oxy.
#
# Required GitHub Environment values (set per-env: dev vs production):
#   Variables:
#     OXY_TARGET     — oxy base URL (e.g. https://app-dev.oxygen-hq.com)
#     OXY_ORG_SLUG   — org these apps belong to
#     OXY_PROJECT_ID — oxy project (workspace) UUID the app binds to
#   Secrets:
#     OXY_TOKEN      — bearer for an account in the `app_admins` table
#                      (mint an API key from /api/api-keys). Must pass
#                      `oxy_app_admin_guard` on the target server.
#
# Channel policy: push to `main` publishes to the DRAFT channel (promote
# later via /admin/apps). Push to `production` adds `--promote` to deploy
# straight to customers.

name: Deploy customer apps

on:
  push:
    branches: [main, production]
    paths:
      - "apps/**"
      - ".github/workflows/deploy.yml"
  workflow_dispatch:

jobs:
  deploy:
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        # Each entry is one customer-app. Add a row to onboard another.
        app:
          - slug: store-pulse
            path: apps/store-pulse
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: "22"
          cache: npm
          cache-dependency-path: ${{ matrix.app.path }}/package-lock.json

      - name: Install + build bundle
        working-directory: ${{ matrix.app.path }}
        env:
          # Bake the serve path into asset URLs. Oxy also rewrites this at
          # serve time, but baking it keeps the bundle correct offline.
          OXY_APP_BASE_PATH: "/customer-apps/${{ vars.OXY_ORG_SLUG }}/${{ matrix.app.slug }}/"
        run: |
          npm ci
          npm run build

      - name: Install oxy CLI
        # Pin a version for production; this reference uses the installer.
        run: curl -sSL https://oxygen-hq.com/install | sh

      # One call: uploads out/ to oxy → S3, records a versioned build, and
      # points the channel at it. `--promote` only on the production branch
      # so main stays a draft until an engineer promotes it in /admin/apps.
      - name: Publish bundle to oxy
        working-directory: ${{ matrix.app.path }}
        env:
          OXY_TOKEN: ${{ secrets.OXY_TOKEN }}
        run: |
          PROMOTE=""
          if [ "${{ github.ref }}" = "refs/heads/production" ]; then
            PROMOTE="--promote"
          fi
          oxy publish \
            --target "${{ vars.OXY_TARGET }}" \
            --org "${{ vars.OXY_ORG_SLUG }}" \
            --app "${{ matrix.app.slug }}" \
            --project "${{ vars.OXY_PROJECT_ID }}" \
            --build-id "${{ github.sha }}" \
            --dir out \
            $PROMOTE
