{
  "name": "create-oxy-app",
  "version": "0.1.0",
  "description": "Scaffold a new Oxy customer app from a curated template.",
  "type": "module",
  "bin": {
    "create-oxy-app": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "oxy",
    "customer-apps",
    "create",
    "scaffold"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsdown": "^0.21.10",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
