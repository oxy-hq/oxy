{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022"],
    "declaration": false,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node"],
    // `@oxy-hq/sdk/manifest` is read FROM SOURCE, not from the SDK's `dist`:
    // CI typechecks every sdk package in parallel before anything is built, so
    // a resolution through `dist` would race its own producer. The same
    // mapping is in `tsdown.config.ts` (the bundle inlines it — a published
    // `oxyc` carries no runtime dependency on the SDK) and `vitest.config.ts`.
    // `rootDir` is the sdk/ directory for the same reason: the mapped file
    // sits outside `src`, and TypeScript refuses an input outside the root
    // (TS6059) even with `noEmit`. Nothing is emitted by `tsc` here.
    "paths": {
      "@oxy-hq/sdk/manifest": ["../typescript/src/manifest.ts"]
    }
  },
  "include": ["src/**/*"],
  // `./template` is the SCAFFOLD at the package root, not `src/template`. The
  // two spellings behave identically and the prefix is kept because they do not
  // READ identically — the entry is inert while `include` stays `src/**/*`.
  // Full reasoning: internal-docs/oxy-api-cli.md, "What CI checks about the SDK
  // packages".
  "exclude": ["node_modules", "dist", "./template"]
}
