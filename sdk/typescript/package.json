{
  "name": "@oxy-hq/sdk",
  "version": "2.3.0",
  "description": "React SDK for building customer-app bundles on the Oxy platform",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./email": {
      "import": {
        "types": "./dist/email.d.mts",
        "default": "./dist/email.mjs"
      },
      "require": {
        "types": "./dist/email.d.cts",
        "default": "./dist/email.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build",
    "publish:beta": "npm publish --tag beta",
    "publish:latest": "npm publish --tag latest"
  },
  "keywords": [
    "oxy",
    "data",
    "analytics",
    "sdk",
    "react",
    "customer-apps"
  ],
  "author": "Oxy Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/oxy-hq/oxy-internal.git",
    "directory": "sdk/typescript"
  },
  "bugs": {
    "url": "https://github.com/oxy-hq/oxy-internal/issues"
  },
  "homepage": "https://oxygen-hq.com",
  "peerDependencies": {
    "preact": "^10.0.0",
    "preact-render-to-string": "^6.0.0",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "preact": {
      "optional": true
    },
    "preact-render-to-string": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "eslint": "^10.7.0",
    "preact": "^10.29.7",
    "preact-render-to-string": "^6.7.0",
    "react": "^19.2.7",
    "tsdown": "^0.22.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
