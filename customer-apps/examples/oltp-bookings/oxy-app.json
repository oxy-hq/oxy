{
  "schemaVersion": 2,
  "slug": "oltp-bookings",
  "name": "OLTP Bookings",
  "icon": "icon.svg",
  "functions": {
    "bookings": {
      "route": true,
      "timeoutSeconds": 30,
      "oltp": { "enabled": true },
      "notify": { "kinds": { "booking_created": {} } }
    }
  },
  "notifications": {
    "categories": {
      "bookings": { "label": "Bookings", "description": "New and changed bookings" }
    },
    "kinds": {
      "booking_created": {
        "category": "bookings",
        "label": "New booking",
        "level": "active",
        "actions": [{ "id": "open", "label": "Open booking" }]
      }
    }
  }
}
