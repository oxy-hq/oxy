# env for the local airhouse stack (docker-compose.airhouse.yml)

OXY_DATABASE_URL=postgresql://airhouse:airhouse@localhost:5433/oxydb

OXY_COMPILE_BLOB_S3_BUCKET=oxy-compile-blobs

AWS_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1

OXY_OBSERVABILITY_BACKEND=airhouse
AIRHOUSE_BASE_URL=http://localhost:8080
AIRHOUSE_ADMIN_TOKEN=airhouse-local-token
AIRHOUSE_WIRE_HOST=localhost
AIRHOUSE_WIRE_PORT=5445
OXY_AIRHOUSE_OBS_USER=alice
OXY_AIRHOUSE_OBS_PASSWORD=alice
OXY_AIRHOUSE_OBS_DATABASE=demo
OXY_AIRHOUSE_OBS_INSECURE=true

OXY_OWNER=hello@oxy.tech,hello@oxygen-hq.com
OXY_GLOBAL_ADMINS=virginia@oxy.tech,luong@oxy.tech,nick@oxy.tech,tay@oxy.tech,mars@oxy.tech,hai@oxy.tech,robert@oxy.tech,virginia@oxygen-hq.com,luong@oxygen-hq.com,nick@oxygen-hq.com,tay@oxygen-hq.com,mars@oxygen-hq.com,hai@oxygen-hq.com,robert@oxygen-hq.com
