# Copy to .env and tweak. docker compose auto-loads .env.

# --- Edge worker — Oxy control plane bearer auth ---
# Operator pre-registers an edge box via the Oxy UI:
#   Settings → Workspace → Cameras → Register edge box
# The modal shows EDGE_BOX_ID + EDGE_BOX_TOKEN once. Paste them here.
#
# OXY_URL must include the /api prefix — Oxy mounts every backend
# route under /api/* (see crates/app/src/server/router/entry.rs).
OXY_URL=http://host.docker.internal:3000/api
EDGE_BOX_ID=
EDGE_BOX_TOKEN=

MEDIAMTX_URL=rtsp://mediamtx:8554

# Local SQLite outbox path inside the edge container (mapped to a named volume).
OUTBOX_PATH=/var/lib/outbox/outbox.sqlite

# Heartbeats / polling
HEALTH_INTERVAL_S=30
CONFIG_POLL_INTERVAL_S=30

# Logging
LOG_LEVEL=info

# --- Tailscale Funnel (WebRTC Phase 1 — see central/tailscale/README.md) ---
# Generate at: Tailscale admin console → Settings → Keys → "Generate auth key"
# Recommended: reusable=on, ephemeral=off, tags=tag:edge-box, expiry=90d
# Without this set, the `tailscale` service starts but stays unauthed and
# Funnel doesn't come up; operator browsers fall back to HLS-only.
TS_AUTHKEY=

# Optional override; defaults to "video-poc-edge". One DNS name per box.
TS_HOSTNAME=

# The box's full Tailscale Funnel hostname (e.g.
# video-poc-edge.tail666f9b.ts.net). Read it off
# `docker exec video-poc-tailscale tailscale serve status` after Funnel
# is enabled. The worker sends this on every /control/* call so the
# WebRTC session endpoint can hand it to operator browsers. Empty =
# WebRTC disabled for this box; HLS still works.
EDGE_FUNNEL_HOSTNAME=

# --- coturn (WebRTC TURN relay) ---
# Shared HMAC secret. coturn validates the per-session credentials
# Oxy mints by re-deriving them against this same secret. Generate
# with `openssl rand -hex 32`. Must match OXY_CAMERAS_TURN_AUTH_SECRET
# on the Oxy backend.
TURN_AUTH_SECRET=
TURN_REALM=oxygen

# --- Edge inference + VLM (consumed by edge service) ---
# Required to enable on-trigger compliance reports. Without it the edge worker
# still emits camera_events; only the VLM check is disabled.
ANTHROPIC_API_KEY=
# Defaults tuned against real Protect footage:
VLM_MODEL=claude-haiku-4-5-20251001
TRACKER=botsort.yaml
TRIGGER_DWELL_SEC=4
TRACK_COOLDOWN_SEC=300
GLOBAL_MIN_INTERVAL_SEC=60
DWELL_EVENT_EVERY_SEC=30
REQUIRED_ATTIRE=hat,apron
REQUIRED_HYGIENE=glove

# --- P3 (Option C) — PPE-YOLO bbox overlay on Playback ---
# Optional. When set, the worker runs a second YOLO model on the same
# frame it sends to the VLM and ships bounding boxes alongside the
# compliance report. VLM verdict remains authoritative; the bboxes are
# visual hints the Playback page overlays under `?debug=1`.
#
# Bootstrap with the food-industry-ppe Roboflow Universe model
# (https://universe.roboflow.com/proof-87nsb/food-industry-ppe —
# hat, hairnet, apron, glove, mask). Needs a free Roboflow account:
#   1. https://app.roboflow.com → Settings → Workspace → API Key
#   2. ROBOFLOW_API_KEY=… scripts/download-ppe-model.sh
#   3. uncomment + set below
#
# For a zero-config plumbing test (HuggingFace construction PPE — no
# Roboflow account required):
#   scripts/download-ppe-model.sh construction
#   # then: PPE_YOLO_MODEL=/app/models/yolov8n-construction-safety.pt
#
# ROBOFLOW_API_KEY=
# PPE_YOLO_MODEL=/app/models/food-industry-ppe-v1.pt
# PPE_YOLO_CONF_THRESHOLD=0.25

# NOTE: the Protect camera URL and cert fingerprint are currently hardcoded in
# central/mediamtx/mediamtx.yml (paths.cam-protect-01). When we generalize to
# multiple customers' cameras, move them into the cameras table or per-deploy env vars.
