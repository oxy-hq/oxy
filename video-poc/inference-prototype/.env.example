# Copy to .env and fill in. dotenv auto-loads it from CWD.

# --- Required ---
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME

# --- Video input ---
# Path to a local MP4. Can also be passed via --video on the CLI.
VIDEO_PATH=

# --- Models ---
YOLO_MODEL=yolo11n.pt
VLM_MODEL=claude-haiku-4-5-20251001

# --- Camera binding ---
# Must exist in the cameras table (seeded by init.sql).
CAMERA_NAME=video-lm-test

# --- Compliance vocabulary (comma-separated) ---
REQUIRED_ATTIRE=hat,apron
REQUIRED_HYGIENE=glove

# --- Tracker ---
# 'botsort.yaml' is more stable than 'bytetrack.yaml' on wide-angle / fisheye
# footage (less ID churn). Both ship with Ultralytics; no extra files needed.
TRACKER=botsort.yaml

# --- On-trigger VLM ---
# Fire a compliance check when a track sustains presence in the PPE zone for
# >= TRIGGER_DWELL_SEC. After firing, cool down per-track for TRACK_COOLDOWN_SEC
# and globally for GLOBAL_MIN_INTERVAL_SEC.
# 4s is the tuned value for real Protect footage (ByteTrack + 10s missed almost
# every track on the first test run).
TRIGGER_DWELL_SEC=4
TRACK_COOLDOWN_SEC=300
GLOBAL_MIN_INTERVAL_SEC=60

# Periodic dwell event cadence (camera_events row written every N seconds while
# a track holds a zone). Lower = more granular analytics, more rows.
DWELL_EVENT_EVERY_SEC=30

# --- Control-API ---
# URL of the video-poc control-api on this machine.
OXY_CONTROL_API=http://localhost:8080
