# Local ClickHouse observability backend (docker-compose.clickhouse.yml).
# Source before running oxy:  set -a; source .env.clickhouse; set +a

# Point the observability layer at the local ClickHouse.
OXY_OBSERVABILITY_BACKEND=clickhouse
OXY_CLICKHOUSE_URL=http://localhost:8123
OXY_CLICKHOUSE_USER=default
OXY_CLICKHOUSE_PASSWORD=
OXY_CLICKHOUSE_DATABASE=observability

# Enterprise obs UI/routes need owner/admin allow-lists (mirrors .env.airhouse).
OXY_OWNER=hello@oxy.tech,hello@oxygen-hq.com
OXY_GLOBAL_ADMINS=luong@oxy.tech,virginia@oxy.tech,nick@oxy.tech,tay@oxy.tech,mars@oxy.tech,hai@oxy.tech,robert@oxy.tech

# oxy's MAIN database is separate from observability. This stack only provides
# the obs ClickHouse; leave OXY_DATABASE_URL unset to use oxy's embedded dev
# Postgres, or point it at your existing local Postgres, e.g.:
# OXY_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oxy
