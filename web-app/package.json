    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:agentic": "tsx tests/agentic/runner/cli.ts",
    "test:agentic:headed": "HEADED=1 tsx tests/agentic/runner/cli.ts",
    "test:agentic:debug": "DEBUG=1 HEADED=1 tsx tests/agentic/runner/cli.ts",
    "test:unit": "vitest run"
  },
