  "scripts": {
    "dev": "vite",
    "build": "NODE_OPTIONS='--max-old-space-size=8192' tsc -b && vite build",
    "compile": "NODE_OPTIONS='--max-old-space-size=8192' tsc -b",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:ts": "tsc --noEmit",
    "preview": "vite preview",
    "format": "biome check --write --diagnostic-level=error .",
